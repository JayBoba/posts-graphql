scalar Time

type Post {
  id: ID!
  authorId: String!
  title: String!
  body: String!
  commentsEnabled: Boolean!
  createdAt: Time!
  comments(first: Int = 20, after: String): CommentConnection!
}

type Comment {
  id: ID!
  postId: ID!
  parentId: ID
  authorId: String!
  body: String!
  createdAt: Time!
  replies(first: Int = 10, after: String): CommentConnection!
}

type PageInfo {
  endCursor: String
  hasNextPage: Boolean!
}

type PostEdge {
  cursor: String!
  node: Post!
}

type PostConnection {
  edges: [PostEdge!]!
  pageInfo: PageInfo!
}

type CommentEdge {
  cursor: String!
  node: Comment!
}

type CommentConnection {
  edges: [CommentEdge!]!
  pageInfo: PageInfo!
}

input NewPost {
  authorId: String!
  title: String!
  body: String!
  commentsEnabled: Boolean = true
}

input NewComment {
  postId: ID!
  parentId: ID
  authorId: String!
  body: String!
}

type Query {
  posts(first: Int = 20, after: String): PostConnection!
  post(id: ID!): Post
  comment(id: ID!): Comment
}

type Mutation {
  createPost(input: NewPost!): Post!
  createComment(input: NewComment!): Comment!
  setCommentsEnabled(postId: ID!, authorId: String!, enabled: Boolean!): Post!
}

type Subscription {
  commentAdded(postId: ID!): Comment!
}